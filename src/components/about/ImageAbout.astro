---
import StatusHud from "./StatusHud.vue";
import CharacterName from "./CharacterName.astro";
import nameGlow from "@assets/images/name-glow.png";

interface Props {
  srcPath: string;
  alt: string;
  name?: string;
  role?: string;
  birthday?: string;
  skillCount?: number;
}

const { srcPath, alt, name, role, birthday, skillCount } = Astro.props;
---

<div class="portrait-card">
  {name && (
    <img
      src={nameGlow.src}
      alt=""
      aria-hidden="true"
      class="portrait-glow"
    />
  )}
  {name && (
    <div class="portrait-name">
      <CharacterName name={name} role={role ?? ""} />
    </div>
  )}
  <img
    src={srcPath}
    alt={alt}
    class="portrait-image"
  />
  <div class="portrait-hud">
    <StatusHud client:load width="100%" birthday={birthday} skl={skillCount} />
  </div>
</div>

<style>
  .portrait-card { position: relative; width: 100%; height: clamp(24rem, calc(100svh - 16.5rem), 35rem); overflow: hidden; isolation: isolate; background: radial-gradient(circle at 72% 22%, rgba(42, 143, 207, .2), transparent 38%), linear-gradient(135deg, #082e50, #031327 62%, #020912); }
  .portrait-card::before { content: ''; position: absolute; z-index: 3; inset: 0; pointer-events: none; background: linear-gradient(120deg, rgba(41, 175, 229, .13) 1px, transparent 1px); background-size: 90px 90px; }
  .portrait-glow { position: absolute; z-index: 8; top: 1rem; right: 1.35rem; width: auto; height: 78%; pointer-events: none; user-select: none; object-fit: contain; filter: blur(16px) saturate(2.5) hue-rotate(15deg); mix-blend-mode: screen; opacity: .7; }
  .portrait-name { position: absolute; z-index: 20; top: 1.35rem; right: .7rem; overflow: hidden; }
  .portrait-image { position: absolute; z-index: 5; top: .5rem; left: 1rem; display: block; width: calc(100% - 5.8rem); height: calc(100% - .5rem); object-fit: cover; object-position: center top; filter: drop-shadow(0 18px 24px rgba(0, 0, 0, .42)); -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 56%, rgba(0, 0, 0, .9) 66%, transparent 88%); mask-image: linear-gradient(to bottom, #000 0%, #000 56%, rgba(0, 0, 0, .9) 66%, transparent 88%); }
  .portrait-hud { position: absolute; z-index: 18; right: .5rem; bottom: 1.5rem; width: min(55%, 14.5rem); filter: drop-shadow(0 0 12px rgba(44, 187, 238, .18)); }
  @media (max-width: 480px) {
    .portrait-card { height: 31rem; }
    .portrait-image { top: .35rem; left: .5rem; width: calc(100% - 4rem); height: calc(100% - .35rem); object-position: 50% top; -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 54%, rgba(0, 0, 0, .88) 64%, transparent 86%); mask-image: linear-gradient(to bottom, #000 0%, #000 54%, rgba(0, 0, 0, .88) 64%, transparent 86%); }
    .portrait-hud { right: .1rem; bottom: 1rem; width: min(60%, 12.5rem); }
  }
</style>
