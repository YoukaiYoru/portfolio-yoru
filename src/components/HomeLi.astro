---
interface Props {
  href?: string;
}

const { href = "#" } = Astro.props;
---

<a 
  href={href}
  class:list={[
    // Layout: centrado abajo en mobile, largo en desktop
    "relative flex items-center w-full max-w-105 mx-auto px-10 py-4 transition-all duration-300 group outline-none mb-2 mask-alpha mask-r-from-black mask-r-from-50% mask-r-to-transparent",
    "md:w-100 md:max-w-none md:mx-0", // Más largo en desktop
    // Bordes y fondo
    "border-l-[5px] border-l-fflineleft border-t border-b border-ffborder/30 ",
    "bg-linear-to-r from-ffbg/18 to-transparent",
    // Hover: azul intenso y bordes brillantes
    "hover:from-ffhover/80 hover:via-ffhover/50 hover:to-blue-950/10",
    "hover:border-l-ffhover/80 hover:border-t-ffhover/20 hover:border-b-ffhover/20",
    "hover:shadow-[inset_6px_0_20px_rgba(59,130,246,0.4)]",
    "hover:mask-alpha hover:mask-r-from-black hover:mask-r-from-50% hover:mask-r-to-transparent"
  ]}
>
  {/* Barra de luz lateral: semi-visible por defecto, brilla en hover */}
  <div class="absolute -left-1 top-0 h-full w-0.75 bg-white/30 shadow-none transition-all duration-300 group-hover:bg-white group-hover:shadow-[0_0_12px_rgba(255,255,255,0.6),0_0_30px_rgba(59,130,246,0.5)]"></div>

  <span class:list={[
    "text-4xl font-display tracking-wide transition-all duration-300",
    "text-slate-300 group-hover:text-white group-hover:-translate-x-2 group-hover:-translate-y-0.5 group-hover:drop-shadow-[0_0_16px_rgba(255,255,255,1),0_0_32px_rgba(59,130,246,0.4)] group-hover:text-shadow-lg/20"
  ]}>
    <slot />
  </span>
</a>