---
import StatusHud from "@components/StatusHud.vue";

interface Props {
  srcPath: string;
  alt: string;
}

const { srcPath, alt } = Astro.props;
---

<div class="w-1/3 h-[90%] overflow-hidden relative flex justify-end">
  <img
    src={srcPath}
    alt={alt}
    class="w-2/3 mt-5 mr-28 object-cover drop-shadow-2xl drop-shadow-zinc-950 mask-b-from-50% mask-b-to-transparent relative z-0"
  />
  <div class="absolute -bottom-10 right-40 z-10 w-[60%]">
    <StatusHud client:load width="100%" />
  </div>
</div>