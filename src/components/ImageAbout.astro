---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";


interface Props {
  srcPath: string;
  alt: string;
}

const { srcPath, alt } = Astro.props;
---

<div class="w-1/3 h-[90%] overflow-hidden relative flex justify-end">
  <img 
    src={srcPath} 
    alt={alt} 
    class="w-2/3 
    mt-5 mr-28
    object-cover
    drop-shadow-2xl
    drop-shadow-zinc-950
    mask-b-from-50% mask-b-to-transparent "
  >
  <div class="absolute top-94 left-33 right-0 z-10">
    {/* Contenido aquí */}
    <div class="bg-[#013E77] size-44 [clip-path:polygon(50%_0%,100%_50%,50%_100%,0%_50%)] mask-r-from-5% mask-r-to-transparent outline-2 outline-white outline-offset-2">
      <p class="text-center text-white text-sm font-bold mt-2">
        This is me, Edward, a passionate web developer with a love for crafting immersive digital experiences. With a background in both design and development, I bring a unique blend of creativity and technical expertise to every project. I thrive on pushing the boundaries of what's possible on the web, constantly exploring new technologies and techniques to create engaging and visually stunning websites. When I'm not coding, you can find me experimenting with new design trends or sharing my knowledge through blogging and open-source contributions. Let's connect and create something amazing together!
      </p>
    </div>
  </div>
</div>