---
import iconSheet from "@assets/icons/ffvii-icon-vectors.svg";

export type GameIcon = "sword" | "database" | "crystal" | "shield";

interface Props {
  icon?: GameIcon;
  label?: string;
  size?: string;
}

const { icon = "sword", label, size = "2.4rem" } = Astro.props;
const viewBoxes: Record<GameIcon, string> = {
  sword: "10 9 48 48",
  database: "136 46 49 42",
  crystal: "137 128 48 42",
  shield: "10 87 48 45",
};
---

<span class="game-vector" style={`--icon-size:${size}`} role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"}>
  <svg viewBox={viewBoxes[icon]} preserveAspectRatio="xMidYMid meet">
    <image href={iconSheet.src} width="692" height="692" />
  </svg>
</span>

<style>
  .game-vector { display: inline-grid; flex: none; width: var(--icon-size); height: var(--icon-size); place-items: center; overflow: hidden; background: transparent; filter: drop-shadow(0 0 6px rgba(2, 203, 253, .35)); }
  svg { display: block; width: 100%; height: 100%; }
</style>
