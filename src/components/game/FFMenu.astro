---
type Route = { name: string; shortName?: string; href?: string; subtext?: string; audioSettings?: boolean };

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const routes: Route[] = [
  { name: "About Me",    shortName: "About", href: "/about" },
  { name: "Projects",    href: "/projects", subtext: "12 / 20" },
  { name: "Experience",  shortName: "Exp.", href: "/experience" },
  { name: "Contact",     href: "/contact" },
  { name: "Settings",    audioSettings: true },
];

// small line icons for the compact mobile tab bar, keyed by href (Settings has none, matched by name)
const compactIcons: Record<string, string> = {
  "/about": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.2"/><path d="M4.5 20c0-4.7 3.4-8 7.5-8s7.5 3.3 7.5 8"/></svg>',
  "/projects": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>',
  "/experience": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/></svg>',
  "/contact": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>',
};
const settingsIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2.2" fill="currentColor" stroke="none"/><circle cx="9" cy="17" r="2.2" fill="currentColor" stroke="none"/></svg>';
const getCompactIcon = (route: Route) => (route.href ? compactIcons[route.href] : settingsIcon) ?? settingsIcon;

const normalizePath = (path: string) => {
  if (path.length > 1 && path.endsWith("/")) {
    return path.slice(0, -1);
  }

  return path;
};

const currentPath = normalizePath(Astro.url.pathname);
const isRouteActive = (href?: string) => !!href && currentPath === normalizePath(href);

const baseLinkClasses = "relative z-10 flex items-center w-full mx-auto px-6 py-2 transition-all duration-300 group outline-none mask-alpha mask-r-from-black mask-r-from-60% mask-r-to-transparent border-l-[5px] border-t border-b";
const activeLinkClasses = "border-l-white border-t-ff-hover/40 border-b-ff-hover/40 bg-linear-to-r from-ff-hover/80 via-ff-hover/40 to-blue-950/10 shadow-[inset_6px_0_20px_rgba(59,130,246,0.4)]";
const inactiveLinkClasses = "border-l-ff-line-left border-ff-border/30 bg-linear-to-r from-black to-transparent hover:from-ff-hover/80 hover:via-ff-hover/50 hover:to-blue-950/10 hover:border-l-ff-hover/80 hover:border-t-ff-hover/20 hover:border-b-ff-hover/20 hover:shadow-[inset_6px_0_20px_rgba(59,130,246,0.4)] hover:mask-alpha hover:mask-r-from-black hover:mask-r-from-50% hover:mask-r-to-transparent";

const baseIndicatorClasses = "absolute -left-1 top-0 h-full w-0.75 transition-all duration-300";
const activeIndicatorClasses = "bg-white shadow-[0_0_12px_rgba(255,255,255,0.6),0_0_30px_rgba(59,130,246,0.5)]";
const inactiveIndicatorClasses = "bg-black shadow-none group-hover:bg-white group-hover:shadow-[0_0_12px_rgba(255,255,255,0.6),0_0_30px_rgba(59,130,246,0.5)]";
const itemWrapperClasses = "relative isolate mb-0.5 last:mb-0";
const linkDarkLayerClasses = "absolute inset-0 z-0 translate-x-1 translate-y-9 blur-[1px] pointer-events-none skew-y-10 bg-linear-to-r from-black/40 to-transparent";

const baseTextClasses = "relative z-10 text-2xl transition-all duration-300";
const activeTextClasses = "text-white -translate-x-2 -translate-y-0.5 drop-shadow-[0_0_16px_rgba(255,255,255,1),0_0_32px_rgba(59,130,246,0.4)] text-shadow-lg/20";
const inactiveTextClasses = "text-slate-300 group-hover:text-white group-hover:-translate-x-2 group-hover:-translate-y-0.5 group-hover:drop-shadow-[0_0_16px_rgba(255,255,255,1),0_0_32px_rgba(59,130,246,0.4)] group-hover:text-shadow-lg/20";

// compact: small square tabs laid out horizontally (mobile bottom navbar)
const compactWrapperClasses = "basis-0 flex-1 min-w-0";
const compactLinkClasses = "relative flex min-w-0 flex-col items-center justify-center gap-1 min-h-14 w-full transition-all duration-200 group outline-none border active:scale-95 focus-visible:ring-2 focus-visible:ring-ff-hover focus-visible:ring-offset-1 focus-visible:ring-offset-black";
const compactActiveLinkClasses = "border-ff-hover/70 bg-linear-to-b from-ff-hover/70 via-ff-hover/30 to-blue-950/20 shadow-[0_0_10px_rgba(59,130,246,0.5)]";
const compactInactiveLinkClasses = "border-ff-border/15 bg-linear-to-b from-black to-transparent active:border-ff-hover/60 active:from-ff-hover/40 active:to-blue-950/10";
const compactIconClasses = "h-5 w-5 shrink-0 transition-transform duration-200";
const compactTextClasses = "text-[9.5px] leading-none tracking-tight text-center transition-all duration-200 truncate max-w-full px-0.5";
const compactActiveTextClasses = "text-white font-semibold";
const compactInactiveTextClasses = "text-slate-400";
const compactActiveDotClasses = "absolute top-1 right-1 h-1 w-1 rounded-full bg-white shadow-[0_0_6px_rgba(255,255,255,0.9)]";
---

<nav class:list={[compact ? "grid w-full grid-cols-5 gap-1 px-1" : "flex w-full flex-col"]}>
  {routes.map(route => {
    const isActive = isRouteActive(route.href);

    if (compact) {
      return (
        <div class={compactWrapperClasses}>
          <a
             href={route.audioSettings ? "#audio-settings" : route.href}
             data-astro-prefetch={route.audioSettings ? undefined : "hover"}
            role={route.audioSettings ? "button" : undefined}
            data-audio-settings={route.audioSettings ? "" : undefined}
            aria-current={isActive ? "page" : undefined}
            aria-label={route.name}
            class:list={[
              compactLinkClasses,
              route.audioSettings ? "cursor-pointer" : "",
              isActive ? compactActiveLinkClasses : compactInactiveLinkClasses
            ]}
          >
            {isActive && <span class={compactActiveDotClasses} aria-hidden="true" />}
            <span
              class:list={[compactIconClasses, isActive ? "text-white scale-110" : "text-slate-400"]}
              aria-hidden="true"
              set:html={getCompactIcon(route)}
            />
            <span class:list={[compactTextClasses, isActive ? compactActiveTextClasses : compactInactiveTextClasses]}>
              {route.shortName ?? route.name}
            </span>
          </a>
        </div>
      );
    }

    return (
    <div class={itemWrapperClasses}>
      <a
        href={route.audioSettings ? "#audio-settings" : route.href}
        data-astro-prefetch={route.audioSettings ? undefined : "hover"}
        role={route.audioSettings ? "button" : undefined}
        data-audio-settings={route.audioSettings ? "" : undefined}
        aria-current={isActive ? "page" : undefined}
        class:list={[
          baseLinkClasses,
          route.audioSettings ? "cursor-pointer" : "",
          isActive ? activeLinkClasses : inactiveLinkClasses
        ]}
      >
        <div class:list={[
          `${baseIndicatorClasses} z-10`,
          isActive ? activeIndicatorClasses : inactiveIndicatorClasses
        ]}></div>

        <span class:list={[
          baseTextClasses,
          isActive ? activeTextClasses : inactiveTextClasses
        ]}>
          {route.name}
        </span>
      </a>

      <div class={linkDarkLayerClasses}></div>
    </div>
    );
  })}
</nav>

