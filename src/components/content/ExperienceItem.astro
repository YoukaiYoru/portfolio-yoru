---
import type { Experience } from "@data/types";
interface Props { item: Experience; index: number; }
const { item, index } = Astro.props;
const i18nPrefix = `exp${index + 1}`;
---

<article class="experience-item">
  <div class="experience-item__marker"><span>{String(index + 1).padStart(2, '0')}</span></div>
  <div class="experience-item__content">
    <header>
      <div><span data-i18n={`${i18nPrefix}.period`}>{item.period}</span><span>{item.location}</span></div>
      <h2 data-i18n={`${i18nPrefix}.role`}>{item.role}</h2>
      <p class="company">{item.company}</p>
    </header>
    <p class="summary" data-i18n={`${i18nPrefix}.summary`}>{item.summary}</p>
    <ul class="achievements">
      {item.achievements.map((achievement, ai) => <li data-i18n={`${i18nPrefix}.ach${ai + 1}`}>{achievement}</li>)}
    </ul>
    <ul class="stack" aria-label="Technologies">
      {item.stack.map(technology => <li>{technology}</li>)}
    </ul>
  </div>
</article>

<style>
  .experience-item { position: relative; display: grid; grid-template-columns: 3.5rem 1fr; gap: clamp(1rem, 3vw, 2rem); }
  .experience-item:not(:last-child) { padding-bottom: 2.5rem; }
  .experience-item__marker { position: relative; display: flex; justify-content: center; }
  .experience-item__marker::after { content: ''; position: absolute; top: 2.5rem; bottom: -2.5rem; width: 1px; background: linear-gradient(#2fbce9, rgba(47, 188, 233, .08)); }
  .experience-item:last-child .experience-item__marker::after { display: none; }
  .experience-item__marker span { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border: 1px solid #2a9fe0; color: #72ddff; background: #031326; transform: rotate(45deg); box-shadow: 0 0 15px rgba(42, 159, 224, .22); }
  .experience-item__marker span::first-line { transform: rotate(-45deg); }
  .experience-item__content { padding: 0 0 2rem; border-bottom: 1px solid rgba(67, 180, 224, .18); }
  header > div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; color: #52c9ef; font: .66rem 'Route159-SemiBold', sans-serif; letter-spacing: .12em; text-transform: uppercase; }
  h2 { margin-top: .55rem; font-size: clamp(1.45rem, 3vw, 2rem); font-weight: 400; }
  .company { color: #78dfff; font-size: 1rem; }
  .summary { max-width: 52rem; margin-top: 1rem; color: #a7bdcc; line-height: 1.65; }
  .achievements { display: grid; gap: .55rem; margin-top: 1.1rem; }
  .achievements li { position: relative; padding-left: 1.15rem; color: #d4e3ec; line-height: 1.5; }
  .achievements li::before { content: ''; position: absolute; top: .55rem; left: 0; width: .38rem; height: .38rem; border: 1px solid #4bcdff; transform: rotate(45deg); }
  .stack { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1.2rem; }
  .stack li { padding: .25rem .55rem; border: 1px solid rgba(70, 184, 229, .22); color: #82a8bf; font-size: .72rem; }
  @media (max-width: 520px) { .experience-item { grid-template-columns: 2.3rem 1fr; } .experience-item__marker span { width: 2rem; height: 2rem; font-size: .72rem; } }
</style>
