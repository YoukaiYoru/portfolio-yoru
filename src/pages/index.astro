---
import HomeLi from '@components/home/HomeLi.astro';
import Layout from '../layouts/Layout.astro';
import TreesComponent from '@components/home/TreesComponent.vue';
---

<Layout>
  <div class="grid grid-cols-1 md:grid-cols-3 min-h-screen w-full">
    <div class="order-2 md:order-1 md:col-span-1 flex">
      <ul class="fixed bottom-4 left-0 w-full md:w-auto md:ml-8 mt-4 md:mt-8 z-10">
        <HomeLi href="/about">About</HomeLi>
        <HomeLi href="/projects">Projects</HomeLi>
        <HomeLi href="/experience">Experience</HomeLi>
        <HomeLi audioSettings>Settings</HomeLi>
      </ul>
    </div>
    <div class="order-1 md:order-2 md:col-span-2 flex justify-center">
      <TreesComponent client:load />
    </div>
  </div>
</Layout>
