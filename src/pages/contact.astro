---
import LayoutPrincipal from "../layouts/LayoutPrincipal.astro";
import GamePanel from "@components/game/GamePanel.astro";
import PartyHeader from "@components/game/PartyHeader.astro";
import ContactCard from "@components/content/ContactCard.astro";
import { contactLinks } from "@data/contact";
import { profile } from "@data/profile";

---

<LayoutPrincipal title="Contact">
  <div class="contact-page">
    <PartyHeader label="Comms" mode="Open channel" meta="Connection ready" materia={["blue", "green"]} />
    <div class="contact-layout">
      <GamePanel label="Open channel" number="Online">
        <div class="contact-cta">
          <span class="availability"><i></i>{profile.availability}</span>
          <h2 data-i18n="contact.cta">Tu proxima idea puede empezar con un mensaje.</h2>
          <p data-i18n="contact.ctaDesc">Cuentame el contexto, el objetivo y el estado actual del proyecto. Responderé con preguntas concretas y un siguiente paso claro.</p>
          <a class="primary-action" href={`mailto:${profile.email}?subject=Nuevo proyecto`} data-i18n-subject="contact.emailsubject">Iniciar conversacion <span>↗</span></a>
        </div>
      </GamePanel>
      <div class="contact-links">
        {contactLinks.map(link => <ContactCard {...link} />)}
        <div class="response-card"><span>Response time</span><strong>24 — 48h</strong><p data-i18n="contact.timezone">Zona horaria GMT-5 · Lima</p></div>
      </div>
    </div>
    <p class="contact-footnote" data-i18n="contact.footnote">No se almacenan datos en este sitio. El boton abre tu cliente de correo predeterminado.</p>
  </div>
</LayoutPrincipal>

<style>
  .contact-page { display: grid; gap: 1rem; max-width: 76rem; margin: 0 auto; }
  .contact-layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(18rem, .85fr); gap: 1rem; }
  .contact-cta { display: flex; min-height: 24rem; flex-direction: column; align-items: flex-start; }
  .availability { display: inline-flex; align-items: center; gap: .5rem; color: #7bdbaa; font: .68rem 'Route159-SemiBold', sans-serif; letter-spacing: .12em; text-transform: uppercase; }
  .availability i { width: .55rem; height: .55rem; border-radius: 50%; background: #69ffae; box-shadow: 0 0 12px #4fe794; }
  h2 { max-width: 35rem; margin-top: 1.3rem; font-size: clamp(2rem, 5vw, 3.8rem); font-weight: 400; line-height: 1.02; text-wrap: balance; }
  .contact-cta > p { max-width: 34rem; margin-top: 1.2rem; color: #9bb5c7; line-height: 1.65; }
  .primary-action { display: inline-flex; align-items: center; gap: 1rem; margin-top: auto; padding: .85rem 1.1rem; border: 1px solid #3db8e7; color: #eefaff; background: linear-gradient(90deg, rgba(18, 135, 198, .5), rgba(7, 38, 71, .3)); font: .72rem 'Route159-SemiBold', sans-serif; letter-spacing: .12em; text-transform: uppercase; box-shadow: inset 4px 0 #8ce6ff; transition: box-shadow .2s ease, background .2s ease; }
  .primary-action:hover { background: rgba(29, 170, 231, .5); box-shadow: inset 8px 0 #fff, 0 0 24px rgba(29, 170, 231, .3); }
  .contact-links { display: grid; gap: .65rem; }
  .response-card { display: grid; gap: .2rem; margin-top: .35rem; padding: 1.15rem; border-top: 1px solid rgba(71, 185, 228, .25); color: #7597aa; }
  .response-card span { font: .62rem 'Route159-SemiBold', sans-serif; letter-spacing: .15em; text-transform: uppercase; }
  .response-card strong { color: #dceff8; font-size: 1.7rem; font-weight: 400; }
  .response-card p, .contact-footnote { color: #58778c; font-size: .78rem; }
  .contact-footnote { text-align: center; }
  @media (max-width: 900px) { .contact-layout { grid-template-columns: minmax(0, 1fr); } }
</style>
